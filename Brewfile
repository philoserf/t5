# Brewfile — developer tooling for the t5 workspace.
# Install with: brew bundle   (or: task deps)

brew "go"             # build the generators
brew "go-task"        # task runner (Taskfile.yml)
brew "golangci-lint"  # linter + formatter (gofumpt/goimports/golines bundled in)
brew "poppler"        # pdftotext, for extracting the rulebook PDFs to markdown
